{
  "run_id": "c1919b30b2",
  "final_message": "**Status:** Reproduced\n\n**Expected:** A `<template #_duration>` (or `#_slot2`) passed to a child component replaces that `<slot name=\"_duration\">`'s fallback content, as in v3.5.13. The slot outlet should render the provided template.\n\n**Actual:** The fallback (\"default content for _duration\") is rendered and the provided template is dropped. Slots without a leading underscore (`#title`) render correctly. This happens on this checkout (3.5.17 source) and on published 3.5.14 and 3.5.17.\n\n**Trigger:** A parent component that receives dynamic slots (a `v-if` or `v-for` on a slot `<template>`), with a child component placed inside that parent's slot content. The child is given a slot whose name starts with `_`. The slot outlet doesn't need to exist in the parent. Minimal runtime-compiled form:\n\n```\n<BaseLayout>\n  <template v-if=\"ok\" #s><p>c</p></template>\n  <SubComponent><template #_x><b>PROVIDED</b></template></SubComponent>\n</BaseLayout>\n```\n\nI tried variants. These do not fail: a static (non-`v-if`) slot sibling, no sibling slot, a plain `v-if` on a `<div>`, a slot named `x`, `a_x` or the default slot. These do fail: `#__x`, `v-slot:_x`, scoped `_x`, a `v-for` slot sibling, and an explicit `#default` wrapper.\n\n**Run:** `npx vitest run --project unit packages/vue/__tests__/underscoreSlotName.spec.ts`. It exits 1 now, with 4 of 4 tests failing. The tests compile the reporter's three playground SFCs (App, BaseLayout, SubComponent) and mount them in jsdom. They cover both slot-name pairs from the report (`title`/`_duration` and `slot1`/`_slot2`), each with the non-inline and inline template compile modes. I dropped `lang=\"ts\"` from `<script setup>`, which doesn't affect the result.\n\n**Passes when:**\n- The same spec file run in a scratch dir against published `vue` and `@vue/compiler-sfc` 3.5.13 passes 4/4. On 3.5.14 and 3.5.17 it fails 4/4.\n- With a throwaway one-line edit in `packages/runtime-core/src/componentSlots.ts` (`assignSlots` checking `key !== '_'` instead of `!isInternalKey(key)`), the spec passes 4/4 on this checkout. I reverted that edit.\n\n**Likely cause (pointer only):** When the child is mounted inside a slot of a parent with dynamic slots, `renderSlot` produces a BAIL fragment, so the child mounts with `optimized = false`. In that case `assignSlots` skips every key starting with `_`, so the child's `_duration` slot is never copied into `instance.slots`. Commit 5d166f3 (#13215, in 3.5.14) changed the check from `key !== '_'` to `!isInternalKey(key)`.\n\n**Artifacts:** `packages/vue/__tests__/underscoreSlotName.spec.ts` (new file in the working tree). No production code was changed; the throwaway edit was reverted.\n",
  "run_command": "npx vitest run --project unit packages/vue/__tests__/underscoreSlotName.spec.ts",
  "patch": "diff --git a/packages/vue/__tests__/underscoreSlotName.spec.ts b/packages/vue/__tests__/underscoreSlotName.spec.ts\nnew file mode 100644\nindex 0000000..b9085f0\n--- /dev/null\n+++ b/packages/vue/__tests__/underscoreSlotName.spec.ts\n@@ -0,0 +1,148 @@\n+import * as Vue from 'vue'\n+import { compileScript, compileTemplate, parse } from '@vue/compiler-sfc'\n+\n+// Reproduction for \"Slot <template> not working when its name starts with an\n+// underscore (_) since v3.5.14\" (vuejs/core, reported against 3.5.14 - 3.5.17).\n+//\n+// The SFCs below are the reporter's playground files (App.vue, BaseLayout.vue,\n+// SubComponent.vue), apart from `lang=\"ts\"` on <script setup>, which has no\n+// effect on this. Both slot-name pairs from the report are exercised:\n+// `title`/`_duration` (the playground link showing the bug) and\n+// `slot1`/`_slot2` (the playground link showing the expected v3.5.13 result).\n+//\n+// Conditions from the report:\n+//  - the child component (SubComponent) renders `<slot name=\"_x\">` with\n+//    fallback content and receives `<template #_x>` from its parent\n+//  - SubComponent is placed in the default slot of BaseLayout, next to a\n+//    conditionally rendered named slot template\n+//    (`<template v-if=\"...\" #randomslotname>`) of BaseLayout.\n+\n+const baseLayout = `\n+<template>\n+  <div>\n+    <slot name=\"randomslotname\"></slot>\n+    <slot></slot>\n+  </div>\n+</template>\n+<script setup>\n+</script>\n+`\n+\n+const subComponent = (a: string, b: string) => `\n+<template>\n+  <slot name=\"${a}\">\n+    <div class=\"fallback\">default content for ${a}</div>\n+  </slot>\n+  <slot name=\"${b}\">\n+    <div class=\"fallback\">default content for ${b}</div>\n+  </slot>\n+</template>\n+<script setup>\n+</script>\n+`\n+\n+const app = (a: string, b: string) => `\n+<template>\n+  <BaseLayout>\n+    <template v-if=\"anyConditionCheckHereWillDo\" #randomslotname>\n+      <p>conditional slot</p>\n+    </template>\n+\n+    <SubComponent>\n+      <template #${a}>\n+        <div class=\"provided\">${a} template works</div>\n+      </template>\n+\n+      <template #${b}>\n+        <div class=\"provided\">${b} template works</div>\n+      </template>\n+    </SubComponent>\n+  </BaseLayout>\n+</template>\n+<script setup>\n+  import SubComponent from './SubComponent.vue'\n+  import BaseLayout from './BaseLayout.vue'\n+  const anyConditionCheckHereWillDo = true\n+</script>\n+`\n+\n+// Compile an SFC (script setup + template) to a component object the way\n+// vite-plugin-vue / the playground does, then evaluate it.\n+function compileSFC(\n+  source: string,\n+  filename: string,\n+  deps: Record<string, any>,\n+  inline: boolean,\n+) {\n+  const { descriptor, errors } = parse(source, { filename, ignoreEmpty: false })\n+  if (errors.length) throw errors[0]\n+  const id = filename\n+  const script = compileScript(descriptor, { id, inlineTemplate: inline })\n+  let code = script.content\n+  if (!inline) {\n+    const tpl = compileTemplate({\n+      source: descriptor.template!.content,\n+      filename,\n+      id,\n+      compilerOptions: { bindingMetadata: script.bindings },\n+    })\n+    if (tpl.errors.length) throw tpl.errors[0]\n+    code =\n+      tpl.code.replace(/^export /m, '') +\n+      '\\n' +\n+      code.replace('export default', 'const __sfc__ =') +\n+      '\\n__sfc__.render = render\\nexport default __sfc__'\n+  }\n+  // turn the ES module into a function body\n+  code = code\n+    .replace(\n+      /import\\s*\\{([^}]*)\\}\\s*from\\s*['\"]vue['\"]/g,\n+      (_, names) => `const {${names.replace(/ as /g, ': ')}} = Vue`,\n+    )\n+    .replace(\n+      /import\\s+(\\w+)\\s+from\\s*['\"]\\.\\/(\\w+)\\.vue['\"]/g,\n+      (_, local, file) => `const ${local} = deps.${file}`,\n+    )\n+    .replace(/export default/, 'return')\n+  return new Function('Vue', 'deps', code)(Vue, deps)\n+}\n+\n+function renderApp(a: string, b: string, inline: boolean) {\n+  const BaseLayout = compileSFC(baseLayout, 'BaseLayout.vue', {}, inline)\n+  const SubComponent = compileSFC(\n+    subComponent(a, b),\n+    'SubComponent.vue',\n+    {},\n+    inline,\n+  )\n+  const App = compileSFC(\n+    app(a, b),\n+    'App.vue',\n+    { BaseLayout, SubComponent },\n+    inline,\n+  )\n+  const root = document.createElement('div')\n+  Vue.createApp(App).mount(root)\n+  return root.innerHTML\n+}\n+\n+describe.each([\n+  ['non-inline template (playground dev mode)', false],\n+  ['inline template (production SFC mode)', true],\n+])('slot template names starting with \"_\" - %s', (_, inline) => {\n+  // the slot names of the reporter's bug playground\n+  it('#_duration renders its template instead of the default slot content', () => {\n+    const html = renderApp('title', '_duration', inline)\n+    expect(html).toContain('title template works')\n+    expect(html).toContain('_duration template works')\n+    expect(html).not.toContain('default content for _duration')\n+  })\n+\n+  // the slot names of the reporter's v3.5.13 (\"expected\") playground\n+  it('#_slot2 renders its template instead of the default slot content', () => {\n+    const html = renderApp('slot1', '_slot2', inline)\n+    expect(html).toContain('slot1 template works')\n+    expect(html).toContain('_slot2 template works')\n+    expect(html).not.toContain('default content for _slot2')\n+  })\n+})\n"
}
