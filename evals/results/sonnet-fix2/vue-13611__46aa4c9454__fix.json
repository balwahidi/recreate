  "patch": "diff --git a/packages/runtime-core/__tests__/componentSlots.spec.ts b/packages/runtime-core/__tests__/componentSlots.spec.ts\nindex ad87e53..5856b3f 100644\n--- a/packages/runtime-core/__tests__/componentSlots.spec.ts\n+++ b/packages/runtime-core/__tests__/componentSlots.spec.ts\n@@ -66,6 +66,19 @@ describe('component: slots', () => {\n     render(createBlock(Comp, null, slots), nodeOps.createElement('div'))\n   })\n \n+  test('initSlots: compiled slots with names starting with an underscore should be kept when parent is using manual render function', () => {\n+    const { slots } = renderWithSlots({\n+      _foo: () => 'foo',\n+      bar: () => 'bar',\n+      _: 1,\n+      __: [1],\n+    })\n+    // only compiler markers are dropped, `_foo` is a regular slot\n+    expect(Object.keys(slots).sort()).toEqual(['_foo', 'bar'])\n+    expect(slots._foo()).toBe('foo')\n+    expect(slots).not.toHaveProperty('_')\n+  })\n+\n   test('initSlots: should normalize object slots (when value is null, string, array)', () => {\n     const { slots } = renderWithSlots({\n       _inner: '_inner',\n@@ -162,6 +175,48 @@ describe('component: slots', () => {\n     expect(instance.slots).toHaveProperty('two')\n   })\n \n+  test('updateSlots: dynamic slots with names starting with an underscore (non-optimized)', async () => {\n+    const flag1 = ref(true)\n+\n+    let instance: any\n+    const Child = () => {\n+      instance = getCurrentInstance()\n+      return 'child'\n+    }\n+\n+    const Comp = {\n+      setup() {\n+        return () => [\n+          h(\n+            Child,\n+            null,\n+            createSlots({ _: 2 as any }, [\n+              flag1.value\n+                ? {\n+                    name: '_one',\n+                    fn: () => [h('span')],\n+                  }\n+                : {\n+                    name: '_two',\n+                    fn: () => [h('div')],\n+                  },\n+            ]),\n+          ),\n+        ]\n+      },\n+    }\n+    render(h(Comp), nodeOps.createElement('div'))\n+\n+    expect(instance.slots).toHaveProperty('_one')\n+    expect(instance.slots).not.toHaveProperty('_two')\n+\n+    flag1.value = false\n+    await nextTick()\n+\n+    expect(instance.slots).not.toHaveProperty('_one')\n+    expect(instance.slots).toHaveProperty('_two')\n+  })\n+\n   test('updateSlots: instance.slots should be updated correctly (when slotType is null)', async () => {\n     const flag1 = ref(true)\n \ndiff --git a/packages/runtime-core/src/componentSlots.ts b/packages/runtime-core/src/componentSlots.ts\nindex 6114f6c..95ec184 100644\n--- a/packages/runtime-core/src/componentSlots.ts\n+++ b/packages/runtime-core/src/componentSlots.ts\n@@ -88,6 +88,12 @@ export type RawSlots = {\n \n const isInternalKey = (key: string) => key[0] === '_' || key === '$stable'\n \n+// markers attached to a compiler-generated slots object: `_` is the slot flag\n+// and `__` holds the cache indexes. Slot names that merely start with an\n+// underscore (e.g. `<template #_foo>`) are regular slots and must not be\n+// treated as markers.\n+const isSlotsMarker = (key: string) => key === '_' || key === '__'\n+\n const normalizeSlotValue = (value: unknown): VNode[] =>\n   isArray(value)\n     ? value.map(normalizeVNode)\n@@ -180,7 +186,7 @@ const assignSlots = (\n     // when rendering the optimized slots by manually written render function,\n     // do not copy the `slots._` compiler flag so that `renderSlot` creates\n     // slot Fragment with BAIL patchFlag to force full updates\n-    if (optimized || !isInternalKey(key)) {\n+    if (optimized || !isSlotsMarker(key)) {\n       slots[key] = children[key]\n     }\n   }\n@@ -252,7 +258,7 @@ export const updateSlots = (\n   // delete stale slots\n   if (needDeletionCheck) {\n     for (const key in slots) {\n-      if (!isInternalKey(key) && deletionComparisonTarget[key] == null) {\n+      if (!isSlotsMarker(key) && deletionComparisonTarget[key] == null) {\n         delete slots[key]\n       }\n     }\ndiff --git a/packages/vue/__tests__/index.spec.ts b/packages/vue/__tests__/index.spec.ts\nindex 0c969f1..9594d95 100644\n--- a/packages/vue/__tests__/index.spec.ts\n+++ b/packages/vue/__tests__/index.spec.ts\n@@ -311,4 +311,75 @@ describe('compiler + runtime integration', () => {\n     app.mount(root)\n     expect(root.innerHTML).toBe('<div>60000000100000111</div>')\n   })\n+\n+  // slot names starting with an underscore, nested inside a parent whose own\n+  // slots are dynamic (v-if on a slot <template>) so the child is patched in\n+  // non-optimized mode\n+  test('slot names starting with an underscore inside dynamic slots', async () => {\n+    const show = ref(true)\n+    const SubComponent = {\n+      template: `\n+        <slot name=\"title\"><i>default title</i></slot>\n+        <slot name=\"_duration\"><i>default duration</i></slot>`,\n+    }\n+    const BaseLayout = {\n+      template: `<div><slot name=\"randomslotname\"></slot><slot></slot></div>`,\n+    }\n+    const App = {\n+      components: { SubComponent, BaseLayout },\n+      setup() {\n+        return { show }\n+      },\n+      template: `\n+        <BaseLayout>\n+          <template v-if=\"show\" #randomslotname>\n+            <p>random</p>\n+          </template>\n+          <SubComponent>\n+            <template #title><b>title</b></template>\n+            <template #_duration><b>duration</b></template>\n+          </SubComponent>\n+        </BaseLayout>`,\n+    }\n+    const container = document.createElement('div')\n+    createApp(App).mount(container)\n+    expect(container.innerHTML).toBe(\n+      `<div><p>random</p><b>title</b><b>duration</b></div>`,\n+    )\n+\n+    show.value = false\n+    await nextTick()\n+    expect(container.innerHTML).toBe(`<div><b>title</b><b>duration</b></div>`)\n+\n+    show.value = true\n+    await nextTick()\n+    expect(container.innerHTML).toBe(\n+      `<div><p>random</p><b>title</b><b>duration</b></div>`,\n+    )\n+  })\n+\n+  test('conditional slot with a name starting with an underscore', async () => {\n+    const show = ref(true)\n+    const Child = {\n+      template: `<slot name=\"_foo\"><i>fallback</i></slot>`,\n+    }\n+    const App = {\n+      components: { Child },\n+      setup() {\n+        return { show }\n+      },\n+      template: `<Child><template v-if=\"show\" #_foo><b>foo</b></template></Child>`,\n+    }\n+    const container = document.createElement('div')\n+    createApp(App).mount(container)\n+    expect(container.innerHTML).toBe(`<b>foo</b>`)\n+\n+    show.value = false\n+    await nextTick()\n+    expect(container.innerHTML).toBe(`<i>fallback</i>`)\n+\n+    show.value = true\n+    await nextTick()\n+    expect(container.innerHTML).toBe(`<b>foo</b>`)\n+  })\n })\n"
