  "run_id": "593a35d3b9",
  "final_message": "**Status:** Reproduced\n\n**Expected:** With the reporter's three SFCs (decoded verbatim from the playground link), `<template #_duration>` passed to `SubComponent` replaces the slot's fallback, as `#title` does and as in v3.5.13. The output should contain `` `_duration` template works `` and not the red \"default slot content for `_duration`\" fallback.\n\n**Actual:** On the given revision (a9269c6, package version 3.5.17), `#title` renders its green content, but `#_duration` falls back to the red default slot content. The rendered HTML is:\n`<div><p>\u2026</p><div style=\"color: green;\">`title` template works</div><div style=\"color: red;\">This is the default slot content for `_duration`.<br>\u2026</div></div>`\n\n**Trigger:** All three of these are needed:\n- A slot `<template>` whose name starts with `_`.\n- `SubComponent` is a child inside the default slot of another component (`BaseLayout`).\n- That `BaseLayout` also has a conditional slot template (`<template v-if=\u2026 #randomslotname>`), which makes its slots dynamic.\n\nI checked two variants. Without the `v-if` template, `#_duration` renders correctly. Renaming the slot to `duration` (keeping the `v-if`) also renders correctly.\n\n**Run:** `npx vitest run --project unit packages/vue/__tests__/slotUnderscoreName.spec.ts`. It exits 1 now, with `expected '<div><p> As long as we are conditiona\u2026' to contain '`_duration` template works'`. The test compiles the reporter's SFCs with the repo's own `compiler-sfc` (non-inline, as the playground does in dev) and mounts them with the repo's runtime and jsdom. The 3.5.13 build was not run.\n\n**Passes when:** I temporarily changed `assignSlots` in `packages/runtime-core/src/componentSlots.ts` from `if (optimized || !isInternalKey(key))` to `if (optimized || (key !== '_' && key !== '__'))`. The check then passed (exit 0). I reverted the change, so the checkout has no production code changes (`git diff` is empty).\n\n**Likely cause (pointer only):** `isInternalKey` is `key[0] === '_' || \u2026`. Since 5d166f3 (#13215), `assignSlots` uses it instead of `key !== '_'`. When slots are assigned with `optimized === false`, which is what the dynamic-slots parent produces, every slot name starting with `_` is dropped, not only the compiler flag.\n\n**Artifacts:**\n- /work/runs/593a35d3b9/repo/packages/vue/__tests__/slotUnderscoreName.spec.ts (the check)\n- /work/runs/593a35d3b9/repo/packages/vue/__tests__/repro/App.vue\n- /work/runs/593a35d3b9/repo/packages/vue/__tests__/repro/BaseLayout.vue\n- /work/runs/593a35d3b9/repo/packages/vue/__tests__/repro/SubComponent.vue\n",
  "run_command": "npx vitest run --project unit packages/vue/__tests__/slotUnderscoreName.spec.ts",
  "patch": "diff --git a/packages/vue/__tests__/repro/App.vue b/packages/vue/__tests__/repro/App.vue\nnew file mode 100644\nindex 0000000..09f7fdd\n--- /dev/null\n+++ b/packages/vue/__tests__/repro/App.vue\n@@ -0,0 +1,27 @@\n+<template>\n+  <BaseLayout>\n+    <template v-if=\"anyConditionCheckHereWillDo\" #randomslotname>\n+      <p>\n+        As long as we are conditionally rendering this slot, the error occurs.<br>\n+        The slot doesn't even have to exist in the component.\n+      </p>\n+    </template>\n+    \n+    <SubComponent>\n+      <template #title>\n+        <div style=\"color: green\">`title` template works</div>\n+      </template>\n+\n+      <template #_duration>\n+        <div style=\"color: green\">`_duration` template works</div>\n+      </template>\n+    </SubComponent>\n+  </BaseLayout>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+  import SubComponent from './SubComponent.vue';\n+  import BaseLayout from './BaseLayout.vue';\n+\n+  const anyConditionCheckHereWillDo = true;\n+</script>\ndiff --git a/packages/vue/__tests__/repro/BaseLayout.vue b/packages/vue/__tests__/repro/BaseLayout.vue\nnew file mode 100644\nindex 0000000..bab7dc3\n--- /dev/null\n+++ b/packages/vue/__tests__/repro/BaseLayout.vue\n@@ -0,0 +1,9 @@\n+<template>\n+  <div>\n+    <slot name=\"randomslotname\"></slot>\n+    <slot></slot>\n+  </div>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+</script>\ndiff --git a/packages/vue/__tests__/repro/SubComponent.vue b/packages/vue/__tests__/repro/SubComponent.vue\nnew file mode 100644\nindex 0000000..ca7c078\n--- /dev/null\n+++ b/packages/vue/__tests__/repro/SubComponent.vue\n@@ -0,0 +1,12 @@\n+<template>\n+  <slot name=\"title\">\n+    <div style=\"color: red\">This is the default slot content for `title`.<br>As long as the slotname starts with an underscore, the template doesn't work.</div>\n+  </slot>\n+\n+  <slot name=\"_duration\">\n+    <div style=\"color: red\">This is the default slot content for `_duration`.<br>As long as the slotname starts with an underscore, the template doesn't work.</div>\n+  </slot>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+</script>\ndiff --git a/packages/vue/__tests__/slotUnderscoreName.spec.ts b/packages/vue/__tests__/slotUnderscoreName.spec.ts\nnew file mode 100644\nindex 0000000..ff7036c\n--- /dev/null\n+++ b/packages/vue/__tests__/slotUnderscoreName.spec.ts\n@@ -0,0 +1,66 @@\n+// Reproduction for: \"Slot <template> not working when its name starts with an\n+// underscore (_) since v3.5.14\".\n+//\n+// The reporter's three SFCs (decoded verbatim from the playground link) live in\n+// ./repro/*.vue. They are compiled here with the repo's own compiler-sfc in\n+// non-inline mode (what the SFC playground does in dev), and mounted with the\n+// repo's own runtime.\n+import { readFileSync } from 'node:fs'\n+import { resolve } from 'node:path'\n+import * as Vue from '../src'\n+import { compileScript, compileTemplate, parse } from '@vue/compiler-sfc'\n+\n+function loadSFC(name: string, components: Record<string, any> = {}) {\n+  const filename = resolve(__dirname, 'repro', name)\n+  const source = readFileSync(filename, 'utf-8')\n+  const { descriptor } = parse(source, { filename })\n+  // an empty <script setup></script> is dropped by the parser (as in the\n+  // playground), in which case there are no binding metadata\n+  const bindingMetadata =\n+    descriptor.script || descriptor.scriptSetup\n+      ? compileScript(descriptor, { id: name, inlineTemplate: false }).bindings\n+      : undefined\n+  const tpl = compileTemplate({\n+    source: descriptor.template!.content,\n+    filename,\n+    id: name,\n+    compilerOptions: { bindingMetadata },\n+  })\n+  expect(tpl.errors).toEqual([])\n+  // turn the ES module output into a plain function\n+  const code = tpl.code\n+    .replace(\n+      /^import \\{([^}]*)\\} from \"vue\"/m,\n+      (_, names) => `const {${names.replace(/ as /g, ': ')}} = Vue`,\n+    )\n+    .replace(/^export function render/m, 'function render')\n+  const render = new Function('Vue', `${code}\\nreturn render`)(Vue)\n+  return {\n+    __file: filename,\n+    __isScriptSetup: true,\n+    setup() {\n+      // what <script setup> would expose to the template\n+      return { ...components, anyConditionCheckHereWillDo: true }\n+    },\n+    render,\n+  }\n+}\n+\n+describe('slot <template> whose name starts with an underscore', () => {\n+  it('renders #_duration content instead of the fallback (reporter repro)', async () => {\n+    const SubComponent = loadSFC('SubComponent.vue')\n+    const BaseLayout = loadSFC('BaseLayout.vue')\n+    const App = loadSFC('App.vue', { SubComponent, BaseLayout })\n+\n+    const root = document.createElement('div')\n+    Vue.createApp(App).mount(root)\n+    await Vue.nextTick()\n+\n+    // control: the non-underscore slot works\n+    expect(root.innerHTML).toContain('`title` template works')\n+    expect(root.innerHTML).not.toContain('default slot content for `title`')\n+    // reported bug: the underscore-named slot falls back to default content\n+    expect(root.innerHTML).toContain('`_duration` template works')\n+    expect(root.innerHTML).not.toContain('default slot content for `_duration`')\n+  })\n+})\n"
}
