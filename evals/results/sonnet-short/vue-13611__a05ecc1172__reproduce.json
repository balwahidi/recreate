{
  "run_id": "a05ecc1172",
  "final_message": "**Status:** Reproduced\n\n**Expected:** A `<template #_name>` passed to a component that sits inside a parent's default slot is rendered in place of that slot's fallback content, as in v3.5.13.\n\n**Actual:** The fallback content is rendered, and the provided template is dropped. In the report's App (`#title` and `#_duration`) the output is `<div><p>conditionally rendered slot</p><div>`title` template works</div><div>default content for `_duration`</div></div>`. `#title` works and only the underscore-named slot is lost.\n\n**Trigger:** A component `Sub` is rendered inside the default slot of a parent `Base`. `Base` also has a conditional slot template (`<template v-if=\"c\" #x>`), which makes its slots dynamic. `Sub` receives a slot template whose name starts with `_`. This alone is enough:\n`<Base><template v-if=\"c\" #x>..</template><Sub><template #_a>A</template></Sub></Base>`\nWithout the `v-if` slot on `Base`, the same markup works. A name with no leading underscore also works.\n\n**Run:** `npx vitest run --project unit packages/vue/__tests__/slotUnderscoreName.spec.ts`\nIt exits 1 now, with both tests failing.\n\n**Passes when:**\n- With a throwaway one-line patch in `assignSlots` (`packages/runtime-core/src/componentSlots.ts`), the check exits 0 with 2/2 passing. The patch changed `!isInternalKey(key)` back to `key !== '_'`. I reverted it, and the production code is unchanged.\n- Published vue 3.5.13 renders the templates correctly. Published 3.5.14 and 3.5.17 show the bug, and so does this checkout (3.5.17 plus later commits). This was checked with a standalone script outside the repo, which is not saved with the artifacts.\n\n**Likely cause (pointer only):** `assignSlots` filters keys with `isInternalKey`, which drops any key starting with `_`, not just the internal `_` marker. When the slots are not optimized (`BAIL` path), a real slot named `_a` is skipped. Commit 5d166f3 introduced this change.\n\n**Artifacts:**\n- `packages/vue/__tests__/slotUnderscoreName.spec.ts` (new). It compiles the report's three SFCs with compiler-sfc, as the playground does, and mounts them with the real runtime.\n",
  "run_command": "npx vitest run --project unit packages/vue/__tests__/slotUnderscoreName.spec.ts",
  "patch": "diff --git a/packages/vue/__tests__/slotUnderscoreName.spec.ts b/packages/vue/__tests__/slotUnderscoreName.spec.ts\nnew file mode 100644\nindex 0000000..774e3d1\n--- /dev/null\n+++ b/packages/vue/__tests__/slotUnderscoreName.spec.ts\n@@ -0,0 +1,135 @@\n+/**\n+ * Reproduction for: \"Slot <template> not working when its name starts with an\n+ * underscore (_) since v3.5.14\".\n+ *\n+ * The three components below are the SFCs from the playground in the report,\n+ * compiled the way the SFC playground compiles them (compiler-sfc, non-inline\n+ * template, <script setup> bindings), then mounted with the real runtime.\n+ */\n+import {\n+  compileScript,\n+  compileTemplate,\n+  parse as parseSFC,\n+} from '@vue/compiler-sfc'\n+import * as Vue from '../src'\n+\n+const BASE_LAYOUT = `\n+<template>\n+  <div>\n+    <slot name=\"randomslotname\"></slot>\n+    <slot></slot>\n+  </div>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+</script>\n+`\n+\n+const subComponent = (a: string, b: string) => `\n+<template>\n+  <slot name=\"${a}\">\n+    <div style=\"color: red\">default content for \\`${a}\\`</div>\n+  </slot>\n+\n+  <slot name=\"${b}\">\n+    <div style=\"color: red\">default content for \\`${b}\\`</div>\n+  </slot>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+</script>\n+`\n+\n+const app = (a: string, b: string) => `\n+<template>\n+  <BaseLayout>\n+    <template v-if=\"anyConditionCheckHereWillDo\" #randomslotname>\n+      <p>conditionally rendered slot</p>\n+    </template>\n+\n+    <SubComponent>\n+      <template #${a}>\n+        <div style=\"color: green\">\\`${a}\\` template works</div>\n+      </template>\n+\n+      <template #${b}>\n+        <div style=\"color: green\">\\`${b}\\` template works</div>\n+      </template>\n+    </SubComponent>\n+  </BaseLayout>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+  import SubComponent from './SubComponent.vue';\n+  import BaseLayout from './BaseLayout.vue';\n+\n+  const anyConditionCheckHereWillDo = true;\n+</script>\n+`\n+\n+// Compile an SFC (script setup + template) into a component options object the\n+// same way the playground does (non-inline template, `$setup` bindings).\n+function defineSFC(\n+  filename: string,\n+  source: string,\n+  setupBindings: Record<string, any> = {},\n+): any {\n+  const { descriptor } = parseSFC(source, { filename })\n+  const id = filename.replace(/\\W/g, '_')\n+  // an empty <script setup> is ignored by the parser, as in the playground\n+  const script =\n+    descriptor.script || descriptor.scriptSetup\n+      ? compileScript(descriptor, { id, inlineTemplate: false })\n+      : undefined\n+  const tpl = compileTemplate({\n+    source: descriptor.template!.content,\n+    filename,\n+    id,\n+    compilerOptions: { bindingMetadata: script && script.bindings },\n+  })\n+  if (tpl.errors.length) throw new Error(String(tpl.errors[0]))\n+  const code = tpl.code\n+    .replace(/^import \\{([^}]*)\\} from \"vue\"\\s*$/m, (_, names) => {\n+      const decl = names\n+        .split(',')\n+        .map((n: string) => n.trim().replace(/ as /, ': '))\n+        .join(', ')\n+      return `const { ${decl} } = Vue`\n+    })\n+    .replace(/export function render/, 'function render')\n+  const render = new Function('Vue', `${code}\\nreturn render`)(Vue)\n+  return {\n+    name: id,\n+    render,\n+    // equivalent of the `<script setup>` returned bindings\n+    setup: () => ({ ...setupBindings, anyConditionCheckHereWillDo: true }),\n+  }\n+}\n+\n+function mountApp(a: string, b: string) {\n+  const BaseLayout = defineSFC('BaseLayout.vue', BASE_LAYOUT)\n+  const SubComponent = defineSFC('SubComponent.vue', subComponent(a, b))\n+  const App = defineSFC('App.vue', app(a, b), { BaseLayout, SubComponent })\n+  const root = document.createElement('div')\n+  Vue.createApp(App).mount(root)\n+  return root.innerHTML\n+}\n+\n+describe('slot <template> with a name starting with an underscore', () => {\n+  // names used in the \"working\" (v3.5.13) playground of the report\n+  test('#slot1 and #_slot2 (names from the 3.5.13 playground)', () => {\n+    const html = mountApp('slot1', '_slot2')\n+    expect(html).toContain('`slot1` template works')\n+    // expected: the provided template is rendered, not the fallback content\n+    expect(html).toContain('`_slot2` template works')\n+    expect(html).not.toContain('default content for `_slot2`')\n+  })\n+\n+  // names used in the broken playground of the report\n+  test('#title and #_duration (names from the 3.5.14 playground)', () => {\n+    const html = mountApp('title', '_duration')\n+    expect(html).toContain('`title` template works')\n+    expect(html).toContain('`_duration` template works')\n+    expect(html).not.toContain('default content for `_duration`')\n+  })\n+})\n"
}
