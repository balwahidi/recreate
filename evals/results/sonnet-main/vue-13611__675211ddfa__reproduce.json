{
  "run_id": "675211ddfa",
  "final_message": "**Status:** Reproduced\n\n**Expected:** In `<SubComponent>`, `<template #_duration>` replaces the `_duration` slot's fallback content, as it does in 3.5.13.\n\n**Actual:** The fallback content of `<slot name=\"_duration\">` is rendered and the template content is dropped. `#title` in the same component works. Rendered HTML from the exact playground SFCs on this checkout:\n`<div><p>\u2026</p><div>`title` template works</div><div>This is the default slot content for `_duration`.\u2026</div></div>`\n\n**Trigger:** A component receives a slot whose name starts with `_` (`_duration`, also `_a` and `__c`) while it is rendered inside the default slot of a parent that has any dynamic slot template: `v-if` (even when false), `v-for`, or `#[name]`. Without a dynamic sibling slot, or with a static `#x` sibling, it works. I did not trace why the dynamic sibling matters. My guess is that it makes the child mount un-optimized.\n\n**Run:** `pnpm vitest run --project unit packages/vue/__tests__/slotUnderscoreName.spec.ts`\n\n**Reliability:** Deterministic, 5/5 runs. The spec has 3 tests: the runtime-compiled reporter scenario and the exact-SFC scenario fail, and a control without the conditional sibling passes.\n\n**Version check:** Published `vue` run in jsdom with the same scenario. 3.5.13 renders the `_duration` template. 3.5.14 and 3.5.17 render the fallback. This checkout (3.5.17 source) fails the same way.\n\n**Likely cause (pointer only):** In `assignSlots` in `packages/runtime-core/src/componentSlots.ts`, the published 3.5.13 build has `if (optimized || key !== '_')` and 3.5.14 has `if (optimized || !isInternalKey(key))`. `isInternalKey` is true for any key starting with `_`, so those slots are skipped when `optimized` is false.\n\n**Artifacts:** `/work/runs/675211ddfa/repo/packages/vue/__tests__/slotUnderscoreName.spec.ts` (new, untracked). No production code was changed.\n",
  "run_command": "pnpm vitest run --project unit packages/vue/__tests__/slotUnderscoreName.spec.ts",
  "patch": "diff --git a/packages/vue/__tests__/slotUnderscoreName.spec.ts b/packages/vue/__tests__/slotUnderscoreName.spec.ts\nnew file mode 100644\nindex 0000000..b0db5cf\n--- /dev/null\n+++ b/packages/vue/__tests__/slotUnderscoreName.spec.ts\n@@ -0,0 +1,173 @@\n+import * as Vue from 'vue'\n+import { compileScript, compileTemplate, parse } from '@vue/compiler-sfc'\n+\n+// Reproduction for \"Slot <template> not working when its name starts with an\n+// underscore (_) since v3.5.14\" (vuejs/core#13611).\n+//\n+// Mirrors the reporter's playground:\n+//   App.vue          -> <BaseLayout> with a conditional `#randomslotname`\n+//                       template and a <SubComponent> sibling\n+//   BaseLayout.vue   -> <slot name=\"randomslotname\"/> + <slot/>\n+//   SubComponent.vue -> <slot name=\"title\">default</slot> and\n+//                       <slot name=\"_duration\">default</slot>\n+const { createApp, defineComponent, nextTick } = Vue\n+\n+const BaseLayout = defineComponent({\n+  template: `<div><slot name=\"randomslotname\"></slot><slot></slot></div>`,\n+})\n+\n+const SubComponent = defineComponent({\n+  template: `\n+    <slot name=\"title\"><div class=\"fallback-title\">default title</div></slot>\n+    <slot name=\"_duration\"><div class=\"fallback-duration\">default duration</div></slot>\n+  `,\n+})\n+\n+function mountApp(template: string) {\n+  const root = document.createElement('div')\n+  createApp({\n+    components: { BaseLayout, SubComponent },\n+    data: () => ({ anyConditionCheckHereWillDo: true }),\n+    template,\n+  }).mount(root)\n+  return root\n+}\n+\n+describe('slot template whose name starts with an underscore', () => {\n+  test('reporter scenario: conditional #randomslotname sibling of <SubComponent>', async () => {\n+    const root = mountApp(`\n+      <BaseLayout>\n+        <template v-if=\"anyConditionCheckHereWillDo\" #randomslotname>\n+          <p>conditionally rendered slot</p>\n+        </template>\n+        <SubComponent>\n+          <template #title><div class=\"ok-title\">title works</div></template>\n+          <template #_duration><div class=\"ok-duration\">_duration works</div></template>\n+        </SubComponent>\n+      </BaseLayout>\n+    `)\n+    await nextTick()\n+    // control: a normally named slot works\n+    expect(root.querySelector('.ok-title')).not.toBe(null)\n+    expect(root.querySelector('.fallback-title')).toBe(null)\n+    // reported bug: `_duration` template is ignored, fallback content rendered\n+    expect(root.querySelector('.fallback-duration')).toBe(null)\n+    expect(root.querySelector('.ok-duration')).not.toBe(null)\n+  })\n+\n+  test('control: same markup without the conditional sibling template', async () => {\n+    const root = mountApp(`\n+      <BaseLayout>\n+        <SubComponent>\n+          <template #title><div class=\"ok-title\">title works</div></template>\n+          <template #_duration><div class=\"ok-duration\">_duration works</div></template>\n+        </SubComponent>\n+      </BaseLayout>\n+    `)\n+    await nextTick()\n+    expect(root.querySelector('.ok-title')).not.toBe(null)\n+    expect(root.querySelector('.fallback-duration')).toBe(null)\n+    expect(root.querySelector('.ok-duration')).not.toBe(null)\n+  })\n+\n+  // Same scenario using the reporter's exact SFC sources (script setup, lang=\"ts\"),\n+  // compiled with @vue/compiler-sfc from this checkout.\n+  test('reporter scenario using the exact playground SFCs', async () => {\n+    const sources: Record<string, string> = {\n+      'App.vue': `<template>\n+  <BaseLayout>\n+    <template v-if=\"anyConditionCheckHereWillDo\" #randomslotname>\n+      <p>\n+        As long as we are conditionally rendering this slot, the error occurs.<br>\n+        The slot doesn't even have to exist in the component.\n+      </p>\n+    </template>\n+\n+    <SubComponent>\n+      <template #title>\n+        <div style=\"color: green\">\\`title\\` template works</div>\n+      </template>\n+\n+      <template #_duration>\n+        <div style=\"color: green\">\\`_duration\\` template works</div>\n+      </template>\n+    </SubComponent>\n+  </BaseLayout>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+  import SubComponent from './SubComponent.vue';\n+  import BaseLayout from './BaseLayout.vue';\n+\n+  const anyConditionCheckHereWillDo = true;\n+</script>\n+`,\n+      'BaseLayout.vue': `<template>\n+  <div>\n+    <slot name=\"randomslotname\"></slot>\n+    <slot></slot>\n+  </div>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+</script>\n+`,\n+      'SubComponent.vue': `<template>\n+  <slot name=\"title\">\n+    <div style=\"color: red\">This is the default slot content for \\`title\\`.<br>As long as the slotname starts with an underscore, the template doesn't work.</div>\n+  </slot>\n+\n+  <slot name=\"_duration\">\n+    <div style=\"color: red\">This is the default slot content for \\`_duration\\`.<br>As long as the slotname starts with an underscore, the template doesn't work.</div>\n+  </slot>\n+</template>\n+\n+<script lang=\"ts\" setup>\n+</script>\n+`,\n+    }\n+\n+    const registry: Record<string, any> = {}\n+    const load = (name: string): any => {\n+      if (registry[name]) return registry[name]\n+      const { descriptor } = parse(sources[name], { filename: name })\n+      // these sources use `lang=\"ts\"` but no type annotations of their own; the\n+      // only TS emitted by the compiler is `: any` on params, stripped here\n+      // (an empty <script setup> block is dropped by the parser, so those\n+      // components are compiled as template-only SFCs)\n+      const templateOnly = !descriptor.script && !descriptor.scriptSetup\n+      let code = (\n+        templateOnly\n+          ? compileTemplate({\n+              id: name,\n+              filename: name,\n+              source: descriptor.template!.content,\n+            }).code.replace('export function render', 'function render') +\n+            '\\nreturn { render }'\n+          : compileScript(descriptor, { id: name, inlineTemplate: true })\n+              .content\n+      ).replace(/: any/g, '')\n+      // rewrite ESM imports/exports into something `new Function` can evaluate\n+      code = code\n+        .replace(/import\\s*\\{([^}]*)\\}\\s*from\\s*['\"]vue['\"]/g, (_, names) => {\n+          return `const {${names.replace(/\\s+as\\s+/g, ': ')}} = Vue`\n+        })\n+        .replace(\n+          /import\\s+(\\w+)\\s+from\\s+['\"]\\.\\/([\\w.]+)['\"]/g,\n+          (_, id, file) => `const ${id} = load('${file}')`,\n+        )\n+        .replace(/export default/, 'return')\n+      registry[name] = new Function('Vue', 'load', code)(Vue, load)\n+      return registry[name]\n+    }\n+\n+    const root = document.createElement('div')\n+    createApp(load('App.vue')).mount(root)\n+    await nextTick()\n+    expect(root.innerHTML).toContain('`title` template works')\n+    expect(root.innerHTML).not.toContain('default slot content for `title`')\n+    // reported bug: default slot content for `_duration` is rendered instead\n+    expect(root.innerHTML).not.toContain('default slot content for `_duration`')\n+    expect(root.innerHTML).toContain('`_duration` template works')\n+  })\n+})\n"
}
